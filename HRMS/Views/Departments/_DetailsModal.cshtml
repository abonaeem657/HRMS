@model HRMS.Models.Organization.DepartmentDetailsViewModel
<div class="modal-content">
    <div class="modal-header">
        <h2 class="modal-title fs-5" id="hrmsModalLabel">@T["DepartmentDetails"]</h2>
        <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="@T["Close"].Value"></button>
    </div>
    <div class="modal-body">
        <div class="record-details-panel">
        <table class="table record-details mb-0">
            <caption class="visually-hidden">@T["DepartmentDetails"]</caption>
            <tbody>
                <tr><th scope="row">@T["Code"]</th><td><bdi dir="ltr">@Model.Code</bdi></td></tr>
                <tr><th scope="row">@T["DepartmentName"]</th><td><bdi dir="auto">@Model.Name</bdi></td></tr>
                <tr><th scope="row">@T["Manager"]</th><td><bdi dir="auto">@(Model.ManagerName ?? "—")</bdi></td></tr>
                <tr><th scope="row">@T["Status"]</th><td><bdi dir="auto">@(Model.IsActive ? T["Status.Active"].Value : T["Status.Inactive"].Value)</bdi></td></tr>
            </tbody>
        </table>
    </div>
        <h3 class="h6 mt-4">@T["Employees"] (@(((DisplayPagination)ViewData["Pagination"]!).TotalCount))</h3>
        @if (Model.Employees.Count == 0)
        {
            <p class="text-muted mb-0">@T["NoEmployeesInDepartment"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>@T["EmployeeNumber"]</th><th>@T["Name"]</th><th>@T["JobTitle"]</th><th>@T["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            <tr><td>@employee.EmployeeNumber</td><td>@employee.FullName</td><td>@employee.PositionTitle</td><td>@T.LocalizeValue("Employment.", employee.EmploymentStatus)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="px-3"><partial name="_ListPagination" model="@(ViewData["Pagination"])" /></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Close"]</button></div>
</div>
