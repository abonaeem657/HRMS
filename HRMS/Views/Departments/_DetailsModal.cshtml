@model HRMS.Models.Organization.DepartmentDetailsViewModel
<div class="modal-content">
    <div class="modal-header">
        <h2 class="modal-title fs-5" id="hrmsModalLabel">@T["DepartmentDetails"]</h2>
        <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="@T["Close"].Value"></button>
    </div>
    <div class="modal-body">
        <dl class="row">
            <dt class="col-sm-4">@T["Code"]</dt><dd class="col-sm-8">@Model.Code</dd>
            <dt class="col-sm-4">@T["DepartmentName"]</dt><dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">@T["Manager"]</dt><dd class="col-sm-8">@(Model.ManagerName ?? "—")</dd>
            <dt class="col-sm-4">@T["Status"]</dt><dd class="col-sm-8">@(Model.IsActive ? T["Status.Active"].Value : T["Status.Inactive"].Value)</dd>
        </dl>
        <h3 class="h6 mt-4">@T["Employees"] (@Model.Employees.Count)</h3>
        @if (Model.Employees.Count == 0)
        {
            <p class="text-muted mb-0">@T["NoEmployeesInDepartment"]</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>@T["EmployeeNumber"]</th><th>@T["Name"]</th><th>@T["JobTitle"]</th><th>@T["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            <tr><td>@employee.EmployeeNumber</td><td>@employee.FullName</td><td>@employee.PositionTitle</td><td>@T.LocalizeValue("Employment.", employee.EmploymentStatus)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Close"]</button></div>
</div>
