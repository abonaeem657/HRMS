@model HRMS.Models.Auditing.AuditLogListViewModel
@{
    ViewData["Title"] = T["AuditLog"].Value;
}

<div>
    <div class="mb-4">
        <h1 class="h2 mb-1">@T["AuditLog"]</h1>
        <p class="text-muted mb-0">@T["AuditIntro"]</p>
    </div>

    <form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-6">
            <label for="audit-search" class="form-label">@T["Search"]</label>
            <input id="audit-search" name="Search" value="@Model.Search" class="form-control"
                   placeholder="@T["AuditSearchPlaceholder"]" />
        </div>
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">@T["Search"]</button>
        </div>
    </form>

    <div class="alert alert-info" role="note">
        @T["AuditReadOnlyNote"]
    </div>

    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-striped table-hover align-middle hrms-table mb-0">
            <thead>
                <tr>
                    <th>@T["TimeUtc"]</th>
                    <th>@T["Actor"]</th>
                    <th>@T["Action"]</th>
                    <th>@T["AffectedRecord"]</th>
                    <th>@T["Changes"]</th>
                    <th>@T["Outcome"]</th>
                    <th>@T["RequestId"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">@T["NoResults"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var entry in Model.Items)
                    {
                        <tr>
                            <td dir="ltr">@BusinessClock.ToLocal(entry.OccurredAtUtc)?.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td dir="ltr" class="text-break">@(entry.ActorUserId ?? T["InitialSetupUnknown"].Value)</td>
                            <td><code>@entry.Action</code></td>
                            <td><span>@entry.EntityName</span> <span dir="ltr">#@entry.EntityId</span></td>
                            <td><code class="text-break">@entry.ChangesJson</code></td>
                            <td>@(entry.Outcome == "Success" ? T["Outcome.Success"].Value : T["Outcome.Failure"].Value)</td>
                            <td dir="ltr" class="text-break">@entry.CorrelationId</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="@T["AuditPages"].Value" class="mt-3">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                   asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">@T["Previous"]</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Model.Page / @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                   asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">@T["Next"]</a>
            </li>
        </ul>
    </nav>
</div>
