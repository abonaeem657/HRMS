@model HRMS.Models.Organization.PositionListViewModel
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0 hrms-table">
        <thead><tr><th>@T["Code"]</th><th>@T["PositionTitle"]</th><th>@T["Department"]</th><th>@T["Employees"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead>
        <tbody>
            @if (Model.Positions.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">@T["NoPositionsFound"]</td></tr>
            }
            else
            {
                @foreach (var position in Model.Positions)
                {
                    <tr>
                        <td>@position.Code</td><td>@position.Title</td><td>@(position.DepartmentName ?? T["General"].Value)</td>
                        <td>@position.EmployeeCount</td>
                        <td><span class="badge status-badge @(position.IsActive ? "status-active" : "status-inactive")" data-record-status>@(position.IsActive ? T["Status.Active"].Value : T["Status.Inactive"].Value)</span></td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-modal-url="@Url.Action("Details", new { id = position.PositionId, modal = true })">@T["Details"]</button>
                                @if (User.IsInRoles(IdentityRoles.ManageOrganization))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-modal-url="@Url.Action("Edit", new { id = position.PositionId, modal = true })">@T["Edit"]</button>
                                    <form asp-action="SetActive" asp-route-id="@position.PositionId" method="post" data-active-form>
                                        <input type="hidden" name="isActive" value="@(position.IsActive ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm btn-outline-@(position.IsActive ? "danger" : "success")">
                                            <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                            @(position.IsActive ? T["Disable"].Value : T["Enable"].Value)
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_ListPagination" model="@(ViewData["Pagination"])" />
