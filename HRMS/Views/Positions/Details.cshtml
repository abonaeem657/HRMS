@model HRMS.Models.Organization.PositionDetailsViewModel
@{
    ViewData["Title"] = T["PositionDetails"].Value;
}
<div>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
        <h1 class="h2">@T["PositionDetails"]</h1>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.PositionId" class="btn btn-primary">@T["Edit"]</a>
            <form asp-action="SetActive" asp-route-id="@Model.PositionId" method="post">
                <input type="hidden" name="isActive" value="@(!Model.IsActive)" />
                <button type="submit" class="btn btn-outline-warning">
                    @(Model.IsActive ? T["Disable"].Value : T["Enable"].Value)
                </button>
            </form>
        </div>
    </div>
    <div class="record-details-panel">
        <table class="table record-details mb-0">
            <caption class="visually-hidden">@T["PositionDetails"]</caption>
            <tbody>
                <tr><th scope="row">@T["Code"]</th><td><bdi dir="ltr">@Model.Code</bdi></td></tr>
                <tr><th scope="row">@T["PositionTitle"]</th><td><bdi dir="auto">@Model.Title</bdi></td></tr>
                <tr><th scope="row">@T["Grade"]</th><td><bdi dir="auto">@(Model.Grade ?? T["GradeUnavailable"].Value)</bdi></td></tr>
                <tr><th scope="row">@T["Description"]</th><td><bdi dir="auto">@(Model.Description ?? T["NoDescription"].Value)</bdi></td></tr>
                <tr><th scope="row">@T["Department"]</th><td><bdi dir="auto">@(Model.DepartmentName ?? T["GeneralPosition"].Value)</bdi></td></tr>
                <tr><th scope="row">@T["ActiveEmployees"]</th><td><bdi dir="auto">@Model.EmployeeCount</bdi></td></tr>
                <tr><th scope="row">@T["Status"]</th><td><bdi dir="auto">@(Model.IsActive ? T["Status.Active"].Value : T["Status.Inactive"].Value)</bdi></td></tr>
            </tbody>
        </table>
    </div>
    @if (Model.EmployeeCount > 0)
    {
        <div class="alert alert-info" role="status">
            @T["PositionHasEmployees"]
        </div>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">@T["BackToPositions"]</a>
</div>
