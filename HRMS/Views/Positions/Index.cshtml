@model HRMS.Models.Organization.PositionListViewModel
@{
    ViewData["Title"] = T["PositionManagement"].Value;
}

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">@T["PositionManagement"]</h1>
            <p class="text-muted mb-0">@T["PositionManagementIntro"]</p>
        </div>
        @if (User.IsInRoles(IdentityRoles.ManageOrganization))
        {
            <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create", new { modal = true })">
                <span aria-hidden="true">+</span> @T["AddJobTitle"]
            </button>
        }
    </div>
    <div id="pageStatus" class="alert d-none" role="status" aria-live="polite"></div>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <form asp-action="Index" method="get" class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-5">
                    <label asp-for="Search" class="form-label">@T["PositionSearch"]</label>
                    <input asp-for="Search" class="form-control" />
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
                    <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
                        <option value="">@T["AllPositions"]</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="IsActive" class="form-label">@T["Status"]</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">@T["All"]</option><option value="true">@T["Status.Active"]</option><option value="false">@T["Status.Inactive"]</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">@T["Search"]</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@T["Clear"]</a>
                </div>
            </div>
        </div>
    </form>
    <section id="resultsContainer" class="card shadow-sm border-0" aria-live="polite">
        <div class="card-body"><partial name="_Results" model="Model" /></div>
    </section>
</div>

<div class="modal fade" id="hrmsModal" tabindex="-1" aria-labelledby="hrmsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div id="hrmsModalContent"></div></div>
</div>


