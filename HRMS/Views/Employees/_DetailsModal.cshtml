@model HRMS.Models.Employees.EmployeeDetailsViewModel
<div class="modal-content">
    <div class="modal-header">
        <h2 class="modal-title fs-5" id="hrmsModalLabel">@T["EmployeeDetails"]</h2>
        <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="@T["Close"].Value"></button>
    </div>
    <div class="modal-body">
        <div class="record-details-panel">
        <table class="table record-details mb-0">
            <caption class="visually-hidden">@T["EmployeeDetails"]</caption>
            <tbody>
                <tr><th scope="row">@T["EmployeeNumber"]</th><td><bdi dir="ltr">@Model.EmployeeNumber</bdi></td></tr>
                <tr><th scope="row">@T["Name"]</th><td><bdi dir="auto">@Model.FirstName @Model.LastName</bdi></td></tr>
                <tr><th scope="row">@T["WorkEmail"]</th><td><bdi dir="ltr">@Model.WorkEmail</bdi></td></tr>
                <tr><th scope="row">@T["Phone"]</th><td><bdi dir="ltr">@(Model.PhoneNumber ?? "—")</bdi></td></tr>
                <tr><th scope="row">@T["HireDate"]</th><td><bdi dir="auto">@Model.HireDate.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</bdi></td></tr>
                <tr><th scope="row">@T["EmploymentStatus"]</th><td><bdi dir="auto">@T.LocalizeValue("Employment.", Model.EmploymentStatus)</bdi></td></tr>
                <tr><th scope="row">@T["EmploymentType"]</th><td><bdi dir="auto">@T.LocalizeValue("EmploymentType.", Model.EmploymentType)</bdi></td></tr>
                <tr><th scope="row">@T["Department"]</th><td><bdi dir="auto">@Model.DepartmentName</bdi></td></tr>
                <tr><th scope="row">@T["JobTitle"]</th><td><bdi dir="auto">@Model.PositionTitle</bdi></td></tr>
                <tr><th scope="row">@T["DirectManager"]</th><td><bdi dir="auto">@(Model.ManagerName ?? "—")</bdi></td></tr>
                <tr><th scope="row">@T["WorkLocation"]</th><td><bdi dir="auto">@(Model.WorkLocation ?? "—")</bdi></td></tr>
            </tbody>
        </table>
    </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Close"]</button>
    </div>
</div>
