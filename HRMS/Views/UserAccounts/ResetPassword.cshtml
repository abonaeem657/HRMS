@model HRMS.Models.Identity.ResetPasswordViewModel
@{
    ViewData["Title"] = T["ResetPassword"].Value;
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <h1 class="h2 mb-2">@T["ResetPassword"]</h1>
        <p class="text-muted" dir="ltr">@Model.Email</p>
        <form asp-action="ResetPassword" method="post" class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    <div class="form-text">@T["TemporaryPasswordAdvice"]</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">@T["Reset"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

