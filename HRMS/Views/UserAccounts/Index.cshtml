@model HRMS.Models.Identity.UserAccountListViewModel
@{ var listing = DisplayPagination.Slice(Model.Accounts, Context.Request); }
@{
    ViewData["Title"] = T["UsersManagement"].Value;
}

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">@T["UsersManagement"]</h1>
            <p class="text-muted mb-0">@T["UsersIntro"]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">@T["CreateAccount"]</a>
    </div>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-striped table-hover align-middle hrms-table mb-0">
            <thead>
                <tr><th>@T["Email"]</th><th>@T["Role"]</th><th>@T["Employee"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr>
            </thead>
            <tbody>
                @if (Model.Accounts.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">@T["NoAccounts"]</td></tr>
                }
                else
                {
                    @foreach (var account in listing.Items)
                    {
                        <tr>
                            <td dir="ltr">@account.Email</td>
                            <td>@account.RoleDisplayName</td>
                            <td>@(account.EmployeeId is null ? T["Unlinked"].Value : $"{account.EmployeeNumber} - {account.EmployeeName}")</td>
                            <td>
                                <span class="badge status-badge @(account.IsActive ? "status-active" : "status-inactive")">
                                    @(account.IsActive ? T["Status.Active"].Value : T["Status.Inactive"].Value)
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-action="Edit" asp-route-id="@account.UserId" class="btn btn-sm btn-outline-primary">@T["Edit"]</a>
                                    <a asp-action="ResetPassword" asp-route-id="@account.UserId" class="btn btn-sm btn-outline-secondary">@T["ResetPassword"]</a>
                                    <form asp-action="SetActive" asp-route-id="@account.UserId" method="post">
                                        <input type="hidden" name="isActive" value="@(account.IsActive ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm btn-outline-@(account.IsActive ? "danger" : "success")">
                                            @(account.IsActive ? T["Disable"].Value : T["Enable"].Value)
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_ListPagination" model="listing.Pagination" />
