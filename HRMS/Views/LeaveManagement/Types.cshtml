@model HRMS.Models.LeaveManagement.LeaveTypeFormViewModel
@{ ViewData["Title"] = T["LeaveTypes"].Value; }
<h1 class="h3 mb-3">@T["LeaveTypes"]</h1>
<p class="text-muted">@T["SimpleLeaveTypesHint"]</p>
@if (TempData["StatusMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3">
@foreach (var type in Model.Types)
{
    <div class="col-12 col-lg-4">
        <form asp-action="SaveType" method="post" class="card card-body h-100">
            @Html.AntiForgeryToken()
            <input type="hidden" name="LeaveTypeId" value="@type.LeaveTypeId" />
            <input type="hidden" name="Name" value="@type.Name" />
            <input type="hidden" name="NameAr" value="@type.NameAr" />
            <input type="hidden" name="IsPaid" value="@type.IsPaid.ToString().ToLowerInvariant()" />
            <h2 class="h5">@T.LocalizeValue("LeaveKind.", type.Name)</h2>
            @if (type.Name == "Unpaid")
            {
                <input type="hidden" name="DefaultDaysPerYear" value="0" />
                <p>@T["UnpaidNoAllowance"]</p>
            }
            else
            {
                <label for="days-@type.LeaveTypeId" class="form-label">@T["Label.DefaultDays"]</label>
                <input id="days-@type.LeaveTypeId" name="DefaultDaysPerYear" type="number" min="0" max="366" value="@type.DefaultDaysPerYear" required class="form-control mb-3" />
            }
            <div class="form-check mb-3">
                <input id="active-@type.LeaveTypeId" name="IsActive" type="checkbox" value="true" checked="@type.IsActive" class="form-check-input" />
                <input name="IsActive" type="hidden" value="false" />
                <label for="active-@type.LeaveTypeId" class="form-check-label">@T["Label.IsActive"]</label>
            </div>
            <button type="submit" class="btn btn-primary mt-auto">@T["Save"]</button>
        </form>
    </div>
}
</div>