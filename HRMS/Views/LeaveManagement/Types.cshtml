@model HRMS.Models.LeaveManagement.LeaveTypeFormViewModel
@{
    ViewData["Title"] = T["LeaveTypes"].Value;
}
<h1 class="h3 mb-3">@T["LeaveTypes"]</h1>
<p class="text-muted">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"
    ? "يمكنك إضافة نوع جديد أو تعديل الاسم وعدد الأيام والأجر والحالة من هذه الصفحة. اضبط الأرصدة حسب سياسة مؤسستك؛ الأرصدة الأولية أُضيفت للتجربة."
    : "Add a type or edit its names, annual days, paid status and availability here. Set allowances according to your organization policy; starter allowances are for evaluation.")</p>
@if (TempData["StatusMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }
<form asp-action="SaveType" method="post" class="card card-body mb-4">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="LeaveTypeId" type="hidden" />
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="NameAr" class="form-label"></label><input asp-for="NameAr" class="form-control" /><span asp-validation-for="NameAr" class="text-danger"></span></div>
        <div class="col-md-2"><label asp-for="DefaultDaysPerYear" class="form-label"></label><input asp-for="DefaultDaysPerYear" class="form-control" /><span asp-validation-for="DefaultDaysPerYear" class="text-danger"></span></div>
        <div class="col-md-1 form-check mt-5"><input asp-for="IsPaid" class="form-check-input" /><label asp-for="IsPaid" class="form-check-label"></label></div>
        <div class="col-md-1 form-check mt-5"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="mt-3"><button type="submit" class="btn btn-primary">@T["SaveLeaveType"]</button><a asp-action="Types" class="btn btn-outline-secondary">@T["NewLeaveType"]</a></div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead><tr><th>@T["Name"]</th><th>@T["Arabic"]</th><th>@T["Days"]</th><th>@T["Paid"]</th><th>@T["Status"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model.Types)
        {
            <tr>
                <td>@item.Name</td><td>@item.NameAr</td><td>@item.DefaultDaysPerYear</td><td>@(item.IsPaid ? T["Yes"].Value : T["No"].Value)</td><td>@(item.IsActive ? T["Enabled"].Value : T["Disabled"].Value)</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary leave-type-edit"
                            data-id="@item.LeaveTypeId" data-name="@item.Name" data-name-ar="@item.NameAr"
                            data-days="@item.DefaultDaysPerYear" data-paid="@item.IsPaid.ToString().ToLowerInvariant()"
                            data-active="@item.IsActive.ToString().ToLowerInvariant()">@T["Edit"]</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        document.querySelectorAll(".leave-type-edit").forEach(button => {
            button.addEventListener("click", () => {
                document.getElementById("LeaveTypeId").value = button.dataset.id;
                document.getElementById("Name").value = button.dataset.name;
                document.getElementById("NameAr").value = button.dataset.nameAr;
                document.getElementById("DefaultDaysPerYear").value = button.dataset.days;
                document.getElementById("IsPaid").checked = button.dataset.paid === "true";
                document.getElementById("IsActive").checked = button.dataset.active === "true";
                document.getElementById("Name").focus();
            });
        });
    </script>
}
