@using HRMS.Application.Identity
@{
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = T["UiYourRoleGuide"].Value;
    var steps = new List<(string Title, string Text, string Controller, string Action)>();
    void Add(string titleKey, string textKey, string controller, string action) =>
        steps.Add((T[titleKey].Value, T[textKey].Value, controller, action));
    var administrator = User.IsInRole(IdentityRoles.SystemAdministrator);
    var hrManager = User.IsInRole(IdentityRoles.HRManager);
    var hrOfficer = User.IsInRole(IdentityRoles.HROfficer);
    var managerOnly = User.IsInRole(IdentityRoles.DepartmentManager) && !User.IsInRoles(IdentityRoles.ManageEmployees);
    var auditorOnly = User.IsInRole(IdentityRoles.Auditor) && !User.IsInRoles(IdentityRoles.UseLeaves);
    var employeeOnly = User.IsInRole(IdentityRoles.Employee) && !User.IsInRoles(IdentityRoles.ManageLeaves);
    Add("GuideReadYourEmployeeProfileTitle", "GuideReadYourEmployeeProfileText", "MyProfile", "Index");
    if (User.IsInRoles(IdentityRoles.ManageOrganization))
    {
        Add("GuidePrepareDepartmentsAndTitlesTitle", "GuidePrepareDepartmentsAndTitlesText", "Departments", "Index");
    }
    if (User.IsInRoles(IdentityRoles.ManageEmployees))
    {
        Add("GuideManageEmployeeRecordsTitle", "GuideManageEmployeeRecordsText", "Employees", "Index");
    }
    if (administrator)
    {
        Add("GuideLinkAccountsAndPermissionsTitle", "GuideLinkAccountsAndPermissionsText", "UserAccounts", "Index");
    }
    if (User.IsInRoles(IdentityRoles.ManageLeaveTypes))
    {
        Add("GuideConfigureLeaveTypesTitle", "GuideConfigureLeaveTypesText", "LeaveManagement", "Types");
    }
    if (User.IsInRoles(IdentityRoles.UseAttendance))
    {
        Add("GuideRecordYourAttendanceTitle", "GuideRecordYourAttendanceText", "Attendance", "Index");
    }
    if (User.IsInRoles(IdentityRoles.ManageAttendance))
    {
        Add("GuideCorrectAnAttendanceSessionTitle", "GuideCorrectAnAttendanceSessionText", "Attendance", "Index");
    }
    if (User.IsInRoles(IdentityRoles.UseLeaves))
    {
        Add("GuideSubmitAndTrackLeaveTitle", "GuideSubmitAndTrackLeaveText", "LeaveManagement", "Create");
        Add("GuideReadYourPersonalLeaveReportTitle", "GuideReadYourPersonalLeaveReportText", "LeaveManagement", "MyReport");
    }
    if (User.IsInRoles(IdentityRoles.ManageLeaves))
    {
        Add("GuideReviewScopedLeaveTitle", managerOnly ? "GuideReviewScopedLeaveManager" : "GuideReviewScopedLeaveHr", "LeaveManagement", "Index");
    }
    if (User.IsInRoles(IdentityRoles.ViewReports))
    {
        Add("GuideChooseScopedReportTitle", managerOnly ? "GuideChooseScopedReportManager" : "GuideChooseScopedReportHr", "Reports", "Index");
    }
    if (User.IsInRoles(IdentityRoles.ViewAuditLogs))
    {
        Add("GuideReadAuditHistoryTitle", "GuideReadAuditHistoryText", "AuditLogs", "Index");
    }
    Add("GuideChangeYourPasswordTitle", "GuideChangeYourPasswordText", "Account", "ChangePassword");
}
<section class="guide-hero">
    <span class="guide-role">@foreach (var role in IdentityRoles.All.Where(r => User.IsInRole(r.Name))) { <span class="badge text-bg-light me-1">@T[role.DisplayName]</span> }</span>
    <h1 class="mt-3">@ViewData["Title"]</h1>
    <p>@(T["UiTheseStepsMatchYourAccountPermissionsAnd"].Value)</p>
</section>
@if (managerOnly || auditorOnly || employeeOnly || (hrOfficer && !administrator && !hrManager) || (hrManager && !administrator))
{
    <aside class="alert alert-info">
        @if (managerOnly) { <p class="mb-0">@(T["UiYourScopeIsYourDepartmentInReports"].Value)</p> }
        @if (auditorOnly) { <p class="mb-0">@(T["UiYourRoleIsReadOnlyYourProfile"].Value)</p> }
        @if (employeeOnly) { <p class="mb-0">@(T["UiYourScopeIsPersonalAttendanceLeaveRequests"].Value)</p> }
        @if (hrOfficer && !administrator && !hrManager) { <p class="mb-0">@(T["UiYouCanManageEmployeesAttendanceRequestsAnd"].Value)</p> }
        @if (hrManager && !administrator) { <p class="mb-0">@(T["UiYouCanManageHROperationsAndRead"].Value)</p> }
    </aside>
}
<div class="guide-grid">
@for (var i = 0; i < steps.Count; i++)
{
    var step = steps[i];
    <section class="guide-step">
        <span class="guide-number">@(i + 1)</span><h2>@step.Title</h2><p>@step.Text</p>
        <a asp-controller="@step.Controller" asp-action="@step.Action" class="btn btn-sm btn-outline-primary">@(T["UiOpenPage"].Value)</a>
    </section>
}
</div>