@using HRMS.Application.Identity
@model HRMS.Models.Home.HomeDashboardViewModel
@{
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var controller = "Home";
    var action = "Guide";
    var title = T["UiYourWorkspaceIsReady"].Value;
    var description = T["UiOpenTheGuideToExploreYourRole"].Value;
    var button = T["UiOpenTheGuide"].Value;
    if (User.IsInRoles(IdentityRoles.ManageOrganization) && Model.DepartmentCount == 0)
    { controller = "Departments"; action = "Create"; title = T["UiStartWithYourOrganization"].Value; description = T["UiCreateYourFirstDepartmentThenAJob"].Value; button = T["Departments"].Value; }
    else if (User.IsInRoles(IdentityRoles.ManageOrganization) && Model.PositionCount == 0)
    { controller = "Positions"; action = "Create"; title = T["UiNextDefineJobTitles"].Value; description = T["UiConnectJobTitlesToDepartmentsBeforeAdding"].Value; button = T["JobTitles"].Value; }
    else if (Model.CanViewHrData && Model.EmployeeCount == 0 && Model.DepartmentCount > 0 && Model.PositionCount > 0)
    { controller = "Employees"; action = "Create"; title = T["UiWelcomeYourFirstTeamMember"].Value; description = T["UiCreateTheEmployeeRecordThenAskAn"].Value; button = T["AddEmployee"].Value; }
    else if (User.IsInRoles(IdentityRoles.ManageLeaves))
    { controller = "LeaveManagement"; action = "Index"; title = T["UiKeepYourTeamSRequestsMoving"].Value; description = T["UiReviewPendingRequestsAndTakeActionOr"].Value; button = T["Leave"].Value; }
    else if (User.IsInRole(IdentityRoles.Employee) && Model.HasLinkedEmployee)
    { controller = "Attendance"; action = "Index"; title = T["UiStartYourDayWithACheckIn"].Value; description = T["UiCheckInAndOutAndTrackYour"].Value; button = T["Attendance"].Value; }
    else if (User.IsInRole(IdentityRoles.Auditor))
    { controller = "Reports"; action = "Index"; title = T["UiTheInformationYouNeedToReview"].Value; description = T["UiReviewReportsAndAuditHistoryWithoutEditing"].Value; button = T["Reports"].Value; }
}
<section class="workflow-banner" aria-labelledby="next-step-title">
    <div><span class="workflow-kicker">@(T["UiYOURNEXTSTEP"].Value)</span><h2 id="next-step-title">@title</h2><p>@description</p></div>
    <a class="btn" asp-controller="@controller" asp-action="@action">@button <span aria-hidden="true">↗</span></a>
</section>
