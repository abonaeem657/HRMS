@model HRMS.Models.Reporting.LeaveReportViewModel
@{
    ViewData["Title"] = T["LeaveReport"].Value;
}
<h1 class="h3 mb-3">@T["LeaveReport"]</h1>
<form asp-action="Leaves" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="ShowAll" value="@DisplayPagination.IsShowAll(Context.Request).ToString().ToLowerInvariant()" />
    <div class="col-md-2"><label asp-for="DepartmentId" class="form-label">@T["Department"]</label><select asp-for="DepartmentId" class="form-select"><option value="">@T["All"]</option>@foreach (var option in Model.Options.Departments) { <option value="@option.Id">@option.Text</option> }</select></div>
    <div class="col-md-2"><label asp-for="EmployeeId" class="form-label">@T["Employee"]</label><select asp-for="EmployeeId" class="form-select"><option value="">@T["All"]</option>@foreach (var option in Model.Options.Employees) { <option value="@option.Id">@option.Text</option> }</select></div>
    <div class="col-md-2"><label asp-for="LeaveTypeId" class="form-label">@T["LeaveType"]</label><select asp-for="LeaveTypeId" class="form-select"><option value="">@T["All"]</option>@foreach (var option in Model.Options.LeaveTypes) { <option value="@option.Id">@option.Text</option> }</select></div>
    <div class="col-md-2"><label asp-for="Year" class="form-label">@T["Year"]</label><select asp-for="Year" class="form-select"><option value="">@T["All"]</option>@for (var year = 2100; year >= 2000; year--) { <option value="@year">@year</option> }</select></div>
    <div class="col-md-2"><label asp-for="Status" class="form-label">@T["Status"]</label><select asp-for="Status" class="form-select"><option value="">@T["All"]</option>@foreach (var status in new[] { "Pending", "Approved", "Rejected", "Cancelled" }) { <option value="@status">@T["Status." + status]</option> }</select></div>
    <div class="col-md-2"><button class="btn btn-primary" type="submit">@T["Filter"]</button></div>
</form>
<p class="text-muted">@T["Results"] @Model.Results.TotalCount</p>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>@T["EmployeeNumber"]</th><th>@T["Employee"]</th><th>@T["Department"]</th><th>@T["LeaveType"]</th><th>@T["Period"]</th><th>@T["Days"]</th><th>@T["Status"]</th><th>@T["AppliedAtUtc"]</th></tr></thead><tbody>
@if (Model.Results.Items.Count == 0) { <tr><td colspan="8" class="text-center text-muted">@T["NoResults"]</td></tr> }
@foreach (var row in Model.Results.Items) { <tr><td>@row.EmployeeNumber</td><td>@row.FullName</td><td>@row.DepartmentName</td><td>@row.LeaveTypeName</td><td>@row.StartDate.ToString("yyyy-MM-dd") - @row.EndDate.ToString("yyyy-MM-dd")</td><td>@row.TotalDays</td><td>@T["Status." + row.Status]</td><td>@BusinessClock.ToLocal(row.AppliedAtUtc)?.ToString("yyyy-MM-dd HH:mm")</td></tr> }
</tbody></table></div>
<partial name="_ListPagination" model="@(ViewData["Pagination"])" />
