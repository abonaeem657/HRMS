@model HRMS.Models.Reporting.EmployeeReportViewModel
@{
    ViewData["Title"] = T["EmployeeReportTitle"].Value;
}
<h1 class="h3 mb-3">@T["EmployeeDirectory"]</h1>
<form asp-action="Employees" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="ShowAll" value="@DisplayPagination.IsShowAll(Context.Request).ToString().ToLowerInvariant()" />
    <div class="col-md-2"><label asp-for="DepartmentId" class="form-label">@T["Department"]</label><select asp-for="DepartmentId" class="form-select"><option value="">@T["All"]</option>@foreach (var option in Model.Options.Departments) { <option value="@option.Id">@option.Text</option> }</select></div>
    <div class="col-md-2"><label asp-for="PositionId" class="form-label">@T["JobTitle"]</label><select asp-for="PositionId" class="form-select"><option value="">@T["All"]</option>@foreach (var option in Model.Options.Positions) { <option value="@option.Id">@option.Text</option> }</select></div>
    <div class="col-md-2"><label asp-for="Status" class="form-label">@T["Status"]</label><select asp-for="Status" class="form-select"><option value="">@T["All"]</option>@foreach (var status in Model.Options.EmploymentStatuses) { <option value="@status">@T.LocalizeValue("Employment.", status)</option> }</select></div>
    <div class="col-md-2"><label asp-for="HiredAfter" class="form-label">@T["HiredAfter"]</label><input asp-for="HiredAfter" type="date" class="form-control" /></div>
    <div class="col-md-2"><label asp-for="HiredBefore" class="form-label">@T["HiredBefore"]</label><input asp-for="HiredBefore" type="date" class="form-control" /></div>
    <partial name="_ReportSort" model="@(new Dictionary<string, string> { ["name"] = "Name", ["hiredate"] = "HireDate", ["status"] = "Status" })" />
    <div class="col-md-2"><button class="btn btn-primary" type="submit">@T["Filter"]</button></div>
</form>
<partial name="_ReportExport" />

<p class="text-muted">@T["Results"] @Model.Results.TotalCount</p>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>@T["EmployeeNumber"]</th><th>@T["Name"]</th><th>@T["Email"]</th><th>@T["Department"]</th><th>@T["JobTitle"]</th><th>@T["HireDate"]</th><th>@T["Status"]</th></tr></thead><tbody>
@if (Model.Results.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted">@T["NoResults"]</td></tr> }
@foreach (var row in Model.Results.Items) { <tr><td>@row.EmployeeNumber</td><td>@row.FullName</td><td>@row.WorkEmail</td><td>@row.DepartmentName</td><td>@row.PositionTitle</td><td>@row.HireDate.ToString("d", System.Globalization.CultureInfo.CurrentCulture)</td><td>@T.LocalizeValue("Employment.", row.EmploymentStatus)</td></tr> }
</tbody></table></div>
<partial name="_ListPagination" model="@(ViewData["Pagination"])" />
