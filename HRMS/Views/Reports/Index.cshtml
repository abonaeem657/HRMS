@model HRMS.Models.Reporting.DashboardViewModel
@{
    ViewData["Title"] = T["Dashboard"].Value;
    var summary = Model.Summary;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@T["Dashboard"]</h1>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Employees" class="btn btn-outline-primary">@T["EmployeeDirectory"]</a>
        <a asp-action="Attendance" class="btn btn-outline-primary">@T["AttendanceReport"]</a>
        <a asp-action="Leaves" class="btn btn-outline-primary">@T["LeaveReport"]</a>
        <a asp-action="LeaveDecisions" class="btn btn-outline-primary">@T["LeaveDecisionsSummary"]</a>
        <a asp-action="Employees" asp-route-HiredAfter="@Model.FromDate" asp-route-HiredBefore="@Model.ToDate" class="btn btn-outline-primary">@T["NewHiresInPeriod"]</a>
        <a asp-action="Headcount" class="btn btn-outline-primary">@T["DepartmentSummary"]</a>
    </div>
</div>
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="ShowAll" value="@DisplayPagination.IsShowAll(Context.Request).ToString().ToLowerInvariant()" />
    <div class="col-sm-4"><label asp-for="FromDate" class="form-label">@T["From"]</label><input asp-for="FromDate" class="form-control" /></div>
    <div class="col-sm-4"><label asp-for="ToDate" class="form-label">@T["To"]</label><input asp-for="ToDate" class="form-control" /></div>
    <div class="col-sm-2"><button class="btn btn-primary" type="submit">@T["Update"]</button></div>
</form>
<partial name="_ReportExport" />

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">@T["ActiveEmployees"]</div><div class="h3">@summary.TotalActiveEmployees</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">@T["NewHires"]</div><div class="h3">@summary.NewHires</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">@T["PendingLeaveRequests"]</div><div class="h3">@summary.PendingLeaveRequests</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body"><div class="text-muted">@T["AttendanceRecordsInPeriod"]</div><div class="h3">@summary.Attendance.TotalRecords</div></div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h5">@T["EmployeesByDepartment"]</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead><tr><th>@T["Department"]</th><th>@T["Total"]</th><th>@T["Active"]</th><th>@T["Inactive"]</th></tr></thead>
                <tbody>@foreach (var department in summary.EmployeesByDepartment) { <tr><td>@department.DepartmentName</td><td>@department.TotalEmployees</td><td>@department.ActiveEmployees</td><td>@department.InactiveEmployees</td></tr> }</tbody>
            </table>
        </div>
        <partial name="_ListPagination" model="@(ViewData["DepartmentsPagination"])" />
    </div>
    <div class="col-lg-6">
        <h2 class="h5">@T["EmployeesByStatus"]</h2>
        <div class="table-responsive"><table class="table table-striped"><thead><tr><th>@T["Status"]</th><th>@T["Count"]</th></tr></thead><tbody>@foreach (var item in summary.EmployeesByStatus) { <tr><td>@T.LocalizeValue("Employment.", item.Key)</td><td>@item.Value</td></tr> }</tbody></table></div>
        <partial name="_ListPagination" model="@(ViewData["StatusesPagination"])" />
        <h2 class="h5 mt-4">@T["AttendanceSummary"]</h2>
        <p>@T["StatusPresent"] @summary.Attendance.PresentCount · @T["StatusLate"] @summary.Attendance.LateCount · @T["StatusAbsent"] @summary.Attendance.AbsentCount · @T["HoursWorked"] @summary.Attendance.TotalHoursWorked.ToString("F2")</p>
    </div>
    <div class="col-12">
        <h2 class="h5">@T["AuthorizedRecentActivity"]</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover"><thead><tr><th>@T["TimeUtc"]</th><th>@T["Used"]</th><th>@T["Action"]</th><th>@T["Record"]</th><th>@T["Identifier"]</th></tr></thead>
                <tbody>
                @if (summary.RecentActivity.Count == 0) { <tr><td colspan="5" class="text-muted text-center">@T["NoActivity"]</td></tr> }
                @foreach (var activity in summary.RecentActivity) { <tr><td>@BusinessClock.ToLocal(activity.OccurredAtUtc)?.ToString("G", System.Globalization.CultureInfo.CurrentCulture)</td><td>@activity.ActorUserName</td><td>@activity.Action</td><td>@activity.EntityName</td><td>@activity.EntityId</td></tr> }
                </tbody>
            </table>
        </div>
        <partial name="_ListPagination" model="@(ViewData["ActivityPagination"])" />
    </div>
</div>
