@model IReadOnlyList<HRMS.Application.Reporting.DepartmentHeadcountItem>
@{
    ViewData["Title"] = T["HeadcountSummary"].Value;
}
<h1 class="h3 mb-3">@T["HeadcountByDepartment"]</h1>
<form method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="ShowAll" value="@DisplayPagination.IsShowAll(Context.Request).ToString().ToLowerInvariant()" />
    <partial name="_ReportSort" model="@(new Dictionary<string, string> { ["department"] = "Department", ["employees"] = "Employees", ["active"] = "Active" })" />
    <div class="col-auto"><button class="btn btn-primary" type="submit">@T["Filter"]</button></div>
</form>
<partial name="_ReportExport" />

<div class="table-responsive"><table class="table table-striped table-hover"><thead><tr><th>@T["Department"]</th><th>@T["Manager"]</th><th>@T["Employees"]</th><th>@T["Active"]</th><th>@T["Inactive"]</th><th>@T["JobTitles"]</th></tr></thead><tbody>
@foreach (var row in Model) { <tr><td>@row.DepartmentName</td><td>@row.ManagerName</td><td>@row.TotalEmployees</td><td>@row.ActiveEmployees</td><td>@row.InactiveEmployees</td><td>@row.PositionsCount</td></tr> }
</tbody></table></div>

<partial name="_ListPagination" model="@(ViewData["Pagination"])" />
